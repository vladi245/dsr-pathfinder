#include "resource.h"

// Paths are relative to the project folder, where build.bat runs rc.
IDI_APP ICON "src\\app.ico"
IDR_GUIDE RCDATA "guide.txt"
IDR_NAVMESH RCDATA "navmesh.bin"
IDR_CONFIG RCDATA "config.ini"
IDR_HOOK RCDATA "build\DSRPathfinderHook.dll"

1 VERSIONINFO
FILEVERSION 1, 1, 0, 0
PRODUCTVERSION 1, 1, 0, 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "DSR Pathfinder: a route overlay for Dark Souls Remastered"
      VALUE "ProductName", "DSR Pathfinder"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductVersion", "1.1.0"
      VALUE "LegalCopyright", "MIT License, vladi245"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
